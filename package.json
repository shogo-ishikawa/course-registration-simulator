    "check": "tsc --noEmit && node scripts/validate-data.mjs"
  },
  "dependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "exceljs": "4.4.0",
    "typescript": "5.9.3",
    "vite": "8.2.0"
  },
  "overrides": {
    "uuid": "11.1.1"
  }
}
